# Copy to .env. Never commit .env. Firebase web config values are public, but keep them out of git anyway.

# Backend base URL (FastAPI), including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# true = in-browser fake backend with a stream of incoming orders and a demo login (no backend/Firebase needed).
VITE_USE_MOCKS=false

# Firebase web app config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: Auth emulator, e.g. http://localhost:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=
