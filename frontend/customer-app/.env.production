# Defaults for PRODUCTION builds (npm run build). Safe to commit: it holds no secrets.
# Vite reads this file after .env, so these blanks stop your local dev settings (emulator URL, dev keys)
# from leaking into a live site. deploy\hosting.ps1 sets the real Firebase values at build time.
VITE_API_BASE_URL=/api/v1
VITE_USE_MOCKS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_EMULATOR_URL=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
