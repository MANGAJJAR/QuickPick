# Copy to .env. Never commit .env. These are PUBLIC web config values (not secrets), but keep them out of git anyway.

# Backend base URL (FastAPI). Include the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# true = serve realistic fixture data and a demo login, no backend or Firebase needed.
VITE_USE_MOCKS=false

# Firebase web app config (Firebase console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: connect to the Auth emulator, e.g. http://localhost:9099
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Optional: background push notifications (Firebase Cloud Messaging). Without these, alerts still appear while the app is open.
# Firebase console -> Project settings -> Cloud Messaging -> Web Push certificates -> Key pair
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
