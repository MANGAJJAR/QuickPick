rules_version = '2';

// The browser apps never read or write Firestore directly: every request goes through the backend API,
// which uses the Admin SDK (that bypasses these rules). So the safe rule for clients is "deny everything".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
