# Copy to .env for local development. NEVER commit .env or any key/service-account file.
# In Cloud Run, set these as env vars; secrets via Secret Manager (--set-secrets).

# --- runtime ------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
PORT=8080                          # injected by Cloud Run
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=                # comma-separated origins, e.g. http://localhost:3000

# --- Google / Firebase ----------------------------------------------------
GCP_PROJECT_ID=quickpick-dev
FIRESTORE_DATABASE=(default)
# Local emulators (leave unset in staging/production):
# FIRESTORE_EMULATOR_HOST=localhost:8081
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Credentials: Application Default Credentials only (gcloud auth application-default login
# locally; the Cloud Run service account in the cloud). Do not set GOOGLE_APPLICATION_CREDENTIALS
# to a committed file.

# --- pickup verification ---------------------------------------------------
# SECRET. Required in staging/production (store in Secret Manager). If empty in development an
# ephemeral secret is generated, so QR codes die on every restart.
PICKUP_TOKEN_SECRET=
PICKUP_TOKEN_TTL_SECONDS=600       # lifetime of a QR/OTP credential
PICKUP_OTP_LENGTH=6
PICKUP_MAX_VERIFY_ATTEMPTS=5       # wrong OTP guesses before the OTP locks

# --- discount engine (illustrative numbers) --------------------------------
RIDER_COST_SAVED=35.00
PICKUP_DISCOUNT_RATIO=0.70
MAX_PICKUP_DISCOUNT=25.00
QUICKPICK_FEE=4.00

# --- inventory -----------------------------------------------------------------
LOW_STOCK_THRESHOLD=5

# --- Gemini (reserved for the AI module; not used yet) ---------------------------
GEMINI_API_KEY=                    # SECRET (Secret Manager in cloud)
GEMINI_MODEL=gemini-2.0-flash
