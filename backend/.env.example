# Copy to .env for local development. NEVER commit .env or any key/service-account file.
# In Cloud Run, set these as env vars; secrets via Secret Manager (--set-secrets).

# --- runtime ------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
PORT=8080                          # injected by Cloud Run
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=                # comma-separated origins, e.g. http://localhost:3000

# --- Google / Firebase ----------------------------------------------------
GCP_PROJECT_ID=quickpick-dev
FIRESTORE_DATABASE=(default)
# Local emulators (leave unset in staging/production):
# FIRESTORE_EMULATOR_HOST=localhost:8081
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Credentials: Application Default Credentials only (gcloud auth application-default login
# locally; the Cloud Run service account in the cloud). Do not set GOOGLE_APPLICATION_CREDENTIALS
# to a committed file.

# --- pickup verification ---------------------------------------------------
# SECRET. Required in staging/production (store in Secret Manager). If empty in development an
# ephemeral secret is generated, so QR codes die on every restart.
PICKUP_TOKEN_SECRET=
PICKUP_TOKEN_TTL_SECONDS=600       # lifetime of a QR/OTP credential
PICKUP_OTP_LENGTH=6
PICKUP_MAX_VERIFY_ATTEMPTS=5       # wrong OTP guesses before the OTP locks

# --- discount engine (illustrative numbers) --------------------------------
RIDER_COST_SAVED=35.00
PICKUP_DISCOUNT_RATIO=0.70
MAX_PICKUP_DISCOUNT=25.00
QUICKPICK_FEE=4.00

# --- inventory -----------------------------------------------------------------
LOW_STOCK_THRESHOLD=5

# --- delivery option -----------------------------------------------------------
DELIVERY_FEE=35.00
HANDLING_FEE=9.00                 # delivery orders only; pickup pays none of these
NIGHT_FEE=30.00                   # delivery orders during NIGHT_HOURS; waived on pickup
NIGHT_HOURS=23:00-06:00           # local time, may cross midnight
FREE_DELIVERY_ABOVE=0             # 0 = delivery is never free
DELIVERY_BASE_ETA_MINUTES=18

# --- "riders are busy" walk-in discount (surge pricing in reverse) -----------------
MAX_SURGE_PICKUP_DISCOUNT=40.00   # cap while riders are scarce and the customer is within walking distance
SURGE_THRESHOLD=1.25
MAX_SURGE_MULTIPLIER=1.80
WALK_RADIUS_KM=1.0
RUSH_HOURS=12:30-14:00,19:30-21:30   # local time windows with extra rider demand
LOCAL_UTC_OFFSET_MINUTES=330         # IST
WEATHER_ENABLED=true                 # Open-Meteo, no key; false = always clear unless a store forces it

# --- auto-expiry of uncollected orders -------------------------------------
PLACED_EXPIRY_MINUTES=15           # store never accepted the order (0 = never expire)
READY_EXPIRY_MINUTES=30            # customer never collected a ready order (0 = never expire)
EXPIRY_SWEEP_INTERVAL_SECONDS=60   # in-process sweep; 0 disables (use Cloud Scheduler instead)
JOB_SECRET=                        # SECRET. Enables POST /api/v1/internal/jobs/expire-orders (header X-Job-Secret)

# --- push notifications (Firebase Cloud Messaging) ---------------------------
FCM_ENABLED=false                  # true needs Firebase Admin credentials that may send messages

# --- Gemini (reserved for the AI module; not used yet) ---------------------------
GEMINI_API_KEY=                    # SECRET (Secret Manager in cloud)
GEMINI_MODEL=gemini-2.0-flash
